# GlobalShop Enterprise Big Data Pipeline Environment Configuration
# Copy to .env and adjust as needed

# Execution Engine: 'auto' (detects JVM/Spark and falls back to Pandas), 'spark', or 'pandas'
ETL_ENGINE=auto

# Spark Cluster Master (e.g. 'local[*]', 'spark://master:7077', 'yarn')
SPARK_MASTER=local[*]

# Logging Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Storage Paths (Overrides defaults if specified)
# GLOBALSHOP_INPUT_DIR=./data
# GLOBALSHOP_OUTPUT_DIR=./etl/output
